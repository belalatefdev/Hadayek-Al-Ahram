{
  "expo": {
    "name": "حدائق الأهرام",
    "slug": "hadayek-al-ahram",
    "scheme": "hadayek",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hadayek.alahram"
    },
    "android": {
      "package": "com.hadayek.alahram"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "نحتاج الوصول إلى الصور لإضافة صور العقار إلى إعلانك.",
          "cameraPermission": "نحتاج الكاميرا لتصوير العقار وإضافته إلى الإعلان.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}